{
  "name": "edureach-api",
  "version": "1.0.0",
  "description": "EduReach Platform REST API - NestJS",
  "private": true,
  "scripts": {
    "build":          "nest build",
    "start":          "node dist/main",
    "start:dev":      "nest start --watch",
    "start:debug":    "nest start --debug --watch",
    "test":           "jest",
    "test:watch":     "jest --watch",
    "test:cov":       "jest --coverage",
    "lint":           "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "migration:run":  "typeorm migration:run -d dist/config/data-source.js",
    "migration:gen":  "typeorm migration:generate",
    "seed":           "ts-node src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common":      "^10.3.0",
    "@nestjs/core":        "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/config":      "^3.2.0",
    "@nestjs/typeorm":     "^10.0.2",
    "@nestjs/jwt":         "^10.2.0",
    "@nestjs/passport":    "^10.0.3",
    "@nestjs/swagger":     "^7.3.0",
    "@nestjs/throttler":   "^5.1.2",
    "@nestjs/cache-manager":"^2.2.2",
    "@nestjs/event-emitter":"^2.0.4",
    "@nestjs/schedule":    "^4.0.2",
    "@nestjs/bull":        "^10.1.1",
    "passport":            "^0.7.0",
    "passport-jwt":        "^4.0.1",
    "passport-local":      "^1.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2":    "^0.1.12",
    "typeorm":             "^0.3.20",
    "pg":                  "^8.11.5",
    "redis":               "^4.6.13",
    "cache-manager-redis-yet": "^5.1.3",
    "bcryptjs":            "^2.4.3",
    "class-validator":     "^0.14.1",
    "class-transformer":   "^0.5.1",
    "helmet":              "^7.1.0",
    "compression":         "^1.7.4",
    "reflect-metadata":    "^0.2.2",
    "rxjs":                "^7.8.1",
    "uuid":                "^9.0.1",
    "nodemailer":          "^6.9.13",
    "@aws-sdk/client-s3":  "^3.574.0",
    "@aws-sdk/s3-request-presigner": "^3.574.0",
    "stripe":              "^15.8.0",
    "openai":              "^4.47.1",
    "bull":                "^4.12.9",
    "sharp":               "^0.33.4",
    "multer":              "^1.4.5-lts.1",
    "@types/multer":       "^1.4.11",
    "csv-parser":          "^3.0.0",
    "dayjs":               "^1.11.11",
    "lodash":              "^4.17.21"
  },
  "devDependencies": {
    "@nestjs/cli":         "^10.3.2",
    "@nestjs/schematics":  "^10.1.1",
    "@nestjs/testing":     "^10.3.0",
    "@types/node":         "^20.14.0",
    "@types/bcryptjs":     "^2.4.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/nodemailer":   "^6.4.15",
    "@types/lodash":       "^4.17.5",
    "typescript":          "^5.4.5",
    "ts-node":             "^10.9.2",
    "jest":                "^29.7.0",
    "ts-jest":             "^29.1.4",
    "supertest":           "^7.0.0"
  }
}
